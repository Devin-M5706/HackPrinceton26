# lumos.health orchestrator — environment variables
#
# Copy to .env and fill in. Everything is validated at startup by src/config.ts,
# so a missing or malformed value fails fast with a readable message.
#
# The quickest way to run locally is MOCK_MODE=true, which needs nothing else.

# ── Core ─────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Serves canned triage results and accepts the single bearer token "demo".
# Refused outright when NODE_ENV=production.
MOCK_MODE=true

# Comma-separated browser origins allowed to call the API.
# Required in production; "*" is rejected because every route is credentialed.
CORS_ORIGINS=http://localhost:5173

# Largest decoded screening image accepted, in bytes (default 8 MiB).
MAX_IMAGE_BYTES=8388608

# ── Database (Supabase) ──────────────────────────────────────────────────────
# The service-role key bypasses row-level security. Server-side only — never
# ship it to a browser.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Model inference (Dedalus) ────────────────────────────────────────────────

DEDALUS_API_KEY=
DEDALUS_DCS_URL=https://dcs.dedaluslabs.ai
DEDALUS_MODEL=anthropic/claude-haiku-4-5-20251001

# ── Phone sign-in (Firebase Admin) ───────────────────────────────────────────
# From the service-account JSON. Keep the literal \n escapes in the private key.

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Outbreak notifications (WhatsApp Cloud API) ──────────────────────────────

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ALERT_TO_NUMBER=

# ── Surveillance agent ───────────────────────────────────────────────────────
# Publicly reachable base URL of THIS server, so the surveillance VM can post
# alerts back. Leave blank to skip provisioning the VM (it bills by the hour).
ORCHESTRATOR_URL=

# Shared secret for machine-to-machine calls: starting the VM and dispatching
# alerts. Minimum 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ORCHESTRATOR_INTERNAL_SECRET=
