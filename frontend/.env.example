# lumos.health frontend — build-time environment variables
#
# Copy to .env.local for development, or set these in your host's build settings.
# Vite inlines VITE_* values into the bundle at build time, so everything here is
# PUBLIC. Never put a service-role key, an API secret or a private key in this file.

# Base URL of the orchestrator API.
# Leave blank for same-origin (correct when a reverse proxy serves /api, and what
# `npm run dev` does via the Vite proxy). Set it when the API is on another host.
VITE_API_URL=

# ── Firebase phone sign-in ───────────────────────────────────────────────────
# From Firebase console → Project settings → Your apps → Web app config.
# These are designed to be public; access is controlled by Firebase Auth rules
# and the authorised-domains list, not by keeping the key secret.
# Leave blank to build without phone sign-in — the UI reports it as unavailable.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
